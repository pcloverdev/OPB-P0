// MARK: - Ball Data Model

struct BallData: Identifiable {
    let id = UUID()
    let position: CGPoint       // Ball center in normalized coordinates
    let radius: CGFloat         // Ball radius in normalized coordinates
    let confidence: Float       // Detection confidence (0-1)
    let timestamp: TimeInterval // Frame timestamp
    let velocity: CGVector?     // Optional velocity vector
}

// MARK: - Shot Trajectory Analysis

struct ShotTrajectory {
    let startTime: TimeInterval
    let releasePoint: CGPoint
    let releaseAngle: Double    // Angle in degrees
    let peakHeight: CGPoint     // Highest point of arc
    let arcHeight: Double       // Height of shot arc
    let outcome: ShotOutcome?   // Make/Miss (if detectable)
}

enum ShotOutcome {
    case make
    case miss
    case rimOut
    case airball
    case unknown
}

